;; The proof receipt of Mathesis (PROOF-POLICY §8.5.1, standards e5a39d7),
;; written from the records of THY-1 and APP-1 to APP-4 in
;; docs/status/PROOF-STATUS.adoc. The current receipts come from one CI run of
;; the proof lanes in the pinned Guix (Guix 8edb9da) on main 034f215: run
;; 43498592499. Its log records, for each gated module, the checker and its
;; version, the SHA-256 of the file, the result and the axioms reported (none).
;; Each current receipt carries the inputs manifest of its prover: the union of
;; the first-party files that the graded roots read, from
;;   standards scripts/proof-inputs-sha256.sh --manifest 034f215 PATH...
;; One manifest per prover, because §8.5.1 allows one digest for one commit and
;; one prover. Earlier receipts stay as superseded receipts, each with a reason.
;; The reader derives the grade, and the shared git checker does the §8.5.3
;; checks (just receipt-check):
;;   bun deed_lint.js --proof-receipt-json verification/receipts/theory_praxis.deed
;;   check-proof-receipt.sh --branch origin/main verification/receipts/theory_praxis.deed .
;; The trusted base is each prover-supplied postulate that the Agda import
;; cones reach (agda --dependency-graph): the four of Agda.Primitive, and Char
;; and String, which Applied/IntLaws reaches through Agda.Builtin.Int. Agda
;; 2.7.0.1 postulates these six (its lib/prim sources, read 2026-11-13).
(praxis-deed
  :schema-version "1.0.0"
  :canonical-name "mathesis-theory-receipt"
  :beholding-chora #u5"estate/chora"
  :profile proof-receipt
  :repository "hyperpolymath/mathesis"
  :source-commit "034f215b3b601aa6bdde7471bdc650bc62c0f56c"
  (trusted-base
    (primitive :prover agda :module "Agda.Primitive" :name "Level" :binding "BUILTIN LEVEL")
    (primitive :prover agda :module "Agda.Primitive" :name "lzero" :binding "BUILTIN LEVELZERO")
    (primitive :prover agda :module "Agda.Primitive" :name "lsuc" :binding "BUILTIN LEVELSUC")
    (primitive :prover agda :module "Agda.Primitive" :name "_⊔_" :binding "BUILTIN LEVELMAX")
    (primitive :prover agda :module "Agda.Builtin.Char" :name "Char" :binding "BUILTIN CHAR")
    (primitive :prover agda :module "Agda.Builtin.String" :name "String" :binding "BUILTIN STRING"))
